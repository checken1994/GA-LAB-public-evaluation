def get_domain(domain_id: str) -> dict[str, Any] | None:
    """Get domain metadata by id."""
    return DOMAINS.get(domain_id)

def list_domains() -> list[str]:
    """List all domain ids."""
    return list(DOMAINS.keys())

def get_domains_by_category(category: str) -> list[str]:
    """Get all domain ids in a category."""
    return [d for d, meta in DOMAINS.items() if meta.get('category') == category]

def get_stats() -> dict[str, Any]:
    """Get registry stats."""
    categories: dict[str, int] = {}
    for meta in DOMAINS.values():
        cat = meta.get('category', 'unknown')
        categories[cat] = categories.get(cat, 0) + 1
    return {'total_domains': len(DOMAINS), 'by_category': categories, 'with_local_data': sum(1 for d in DOMAINS.values() if d.get('preferred_apis') == []), 'with_live_fetch': sum(1 for d in DOMAINS.values() if d.get('preferred_apis'))}
