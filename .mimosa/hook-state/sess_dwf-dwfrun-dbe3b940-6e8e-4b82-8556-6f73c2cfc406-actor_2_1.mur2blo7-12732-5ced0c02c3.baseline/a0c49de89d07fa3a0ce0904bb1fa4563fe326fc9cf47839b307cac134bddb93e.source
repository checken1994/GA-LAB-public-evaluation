interface IssueSeed {
  id: string;
  title: string;
  severity: "low" | "medium" | "high";
  area: string;
  /** Vị trí code/host đã xác nhận ở vòng audit. */
  where: string;
  /** Tóm tắt hiện trạng đã confirmed (kèm mốc bằng chứng). */
  status: string;
}

interface FixPlanItem {
  /** id của issue được xử lý. */
  issueId: string;
  /** Hướng fix cụ thể, 3-8 câu. */
  fix: string;
  /** File sẽ đụng đến (path + dòng nếu có). */
  files: string;
  /** Chiến lược test: test mới (tên file/hàm) + NodeID nào được semantic rewrite (nếu có). */
  tests: string;
  /** Tiêu chí nghiệm thu đo đếm được. */
  acceptance: string;
  /** Rủi ro + cách rollback. */
  risk: string;
  /** Có phụ thuộc quyết định/tài nguyên của owner không — ghi rõ hoặc "không". */
  ownerDependency: string;
  /** ước lượng dung lượng: S (<2h) / M (nửa ngày) / L (1-2 ngày). */
  estimate: string;
}

interface ClusterPlan {
  summary: string;
  items: FixPlanItem[];
  /** Ghi chú: xung đột tiềm năng với cụm khác, thứ tự nội bộ, việc không nên làm. */
  notes: string[];
  evidenceLog: string[];
}

interface WavePlan {
  /** Tên wave, ví dụ "W1 — /ask behavior". */
  wave: string;
  /** Mục tiêu 1-2 câu. */
  goal: string;
  /** Các issueId theo thứ tự thực hiện. */
  items: string[];
  /** Điều kiện bắt đầu (owner ack, provider key, main sync...). */
  entryCriteria: string[];
  /** Nghiệm thu wave: lệnh + ngưỡng đạt. */
  acceptance: string[];
  /** Blocker nếu chưa có điều kiện. */
  blockers: string[];
}

interface OpenDecision {
  decision: string;
  options: string;
  recommendation: string;
}

interface MasterPlan {
  summary: string;
  waves: WavePlan[];
  /** Xung đột đã xử lý khi xếp lịch (file chồng nhau, thứ tự bắt buộc...). */
  conflictsResolved: string[];
  openDecisions: OpenDecision[];
  overview: string;
}

interface ReviewFeedback {
  /** Chỗ nào sẽ gãy khi thực thi. */
  problems: string[];
  /** Thiếu gì. */
  missing: string[];
  /** Acceptance nào không đo được hoặc ước lượng sai. */
  unmeasurable: string[];
}

interface WorkflowReport {
  conclusion: string;
  findings: IssueSeed[];
  verified: string[];
  notCovered: string[];
}

const constraints =
  "RÀNG BUỘC BẮT BUỘC khi thiết kế (FA-01→FA-13 + EXECUTION_PROTOCOL): không delete/skip/xfail test hay hạ threshold; " +
  "rewrite test phải giữ 100% NodeID và cấm placebo assertion; dùng monkeypatch.setenv không dùng os.environ trong test; " +
  "xóa tính năng phải đi 5 tầng Top-Down (spec trước, call-graph, semantic rewrite, schema, isolation); " +
  "mỗi fix là small reversible patch + scoped test ngay sau mỗi change; pre-commit Mimosa chặn khi còn HIGH (SystemRandom CHỈ, cấm heredoc sửa source); " +
  "mọi claim nghiệm thu cần same-SHA evidence (full pytest + T00 + verify_scp_test_skill_contract + GitHub gates xanh trên chính SHA đó); " +
  "LLM cost governance — không đề xuất gì gọi LLM tràn lan không cần thiết.";

const probeArtifacts =
  "Bằng chứng vòng 3 còn lưu ở: C:\\Users\\check\\AppData\\Local\\Temp\\scp_ask_probe_results.json (16 response đầy đủ), " +
  "C:\\Users\\check\\AppData\\Local\\Temp\\scp_ask_probe_server.log (52KB log server), C:\\Users\\check\\AppData\\Local\\Temp\\scp_ask_probe_battery.py (script battery — tái sử dụng làm acceptance đo trước/sau).";

