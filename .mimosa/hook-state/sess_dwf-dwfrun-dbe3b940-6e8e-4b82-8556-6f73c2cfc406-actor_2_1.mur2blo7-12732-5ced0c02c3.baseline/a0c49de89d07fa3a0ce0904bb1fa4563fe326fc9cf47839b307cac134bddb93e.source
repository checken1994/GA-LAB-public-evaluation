phase("Chốt provenance và inventory");

const head = await world.run("git", ["rev-parse", "HEAD"]);
const sha = head.stdout.trim();
const dirty = await world.run("git", ["status", "--porcelain"]);
log("HEAD=" + sha + " | dirty lines=" + dirty.stdout.trim().split("\n").filter((l) => l.trim()).length);

phase("Thiết kế xử lý theo 4 cụm");

const commonAsk =
  "Điều kiện chung: HEAD=" + sha + " (đây là SHA mọi fix sẽ đụng). " + constraints + " " +
  "Trước khi thiết kế fix cho từng issue: grep/read đúng các file:dòng trong 'where' để xác nhận còn nguyên tại HEAD (pointer đến từ audit hôm nay, cùng SHA). " +
  "Với MỖI issue trả về FixPlanItem: fix (hướng cụ thể, smallest reversible), files, tests (tên test mới + NodeID được semantic rewrite nếu có + cách chứng minh old-fails/new-passes), acceptance (đo đếm được), risk+rollback, ownerDependency, estimate S/M/L. " +
  "KHÔNG sửa bất kỳ file nào — đây là vòng lập kế hoạch.";

const [askPlan, debtPlan, opsPlan, ownerPlan] = await Promise.all([
  agent("Thiết kế fix — /ask pipeline", {
    system:
      "Bạn là kỹ sư thiết kế fix cho pipeline /ask của SCP. CHỈ ĐỌC (không sửa file, không boot service, không gọi /ask). " + constraints,
  }).ask<ClusterPlan>(
    commonAsk + " Cụm của bạn: " + JSON.stringify(invAsk) + " " +
    "Ngữ cảnh hành vi: battery 16 probe hôm nay 12/16 PASS; 4 fail = q01 (root-2), q05/q11 (root-1), q08 (root-3). " + probeArtifacts + " " +
    "Yêu cầu riêng: (1) root-1 — thiết kế fix lease (nâng TTL/knob + heartbeat retry bền vững + chốt nguyên nhân missed-renewal bằng test tái hiện); (2) root-2 — relevance check answer↔question trước khi PASS ở fork; (3) root-3 — tách governance KILL khỏi FAIL-verdict + family độc lập phải theo MODEL thật (khác base_url+model), nêu rõ phần nào chờ own-provider-keys; (4) root-4 — thứ tự rule + regex + fail-closed classifier (đề xuất spec phân loại đúng cho 16 câu battery); (5) root-5 — pin identity + post-guard; (6) root-6 — cap tổng latency + hedge cho cross_verify. " +
    "Thiết kế luôn ACCEPTANCE WAVE: tái sử dụng battery script trong TEMP làm đo trước/sau — nêu ngưỡng đạt cụ thể (ví dụ ≥14/16 PASS, q05/q11 không withheld, q01 answer chứa 'Paris', q08 không bị KILL, 0 sai phân loại trong 5 case đã biết).",
  ),
  agent("Thiết kế fix — nợ code & CI", {
    system:
      "Bạn là kỹ sư thiết kế fix nợ kỹ thuật SCP. CHỈ ĐỌC (không sửa file). " + constraints,
  }).ask<ClusterPlan>(
    commonAsk + " Cụm của bạn: " + JSON.stringify(invDebt) + " " +
    "Yêu cầu riêng: (1) code-1 — chiến lược sweep 179 findings an toàn (B20 rules: chỉ thêm log+exc_info giữ nguyên hành vi; policy noqa minh bạch trong scp/ruff.toml; chống tái phát — bật rule enforcement thế nào mà không phá baseline E9/F); (2) contract-5 — các phương án (chỉnh trigger workflow / chấp nhận + đánh dấu expected / chạy đúng luồng RC để có verdict) kèm khuyến nghị; (3) ga-206 — nội dung cập nhật GA.md:206 chính xác; (4) crawler-noise — bỏ nguồn chết + optional deps cho 'datasets'; (5) code-4/code-5 — fix nhỏ trực tiếp.",
  ),
  agent("Thiết kế fix — vận hành & deployment", {
    system:
      "Bạn là kỹ sư vận hành SCP. CHỈ ĐỌC (không start/stop gì, không sửa file). " + constraints,
  }).ask<ClusterPlan>(
    commonAsk + " Cụm của bạn: " + JSON.stringify(invOps) + " " +
    "Yêu cầu riêng: (1) teardown-recipe — chuẩn hóa quy trình tắt sạch (dựa scp_247_control.ps1 kill-switch có sẵn + thứ tự Disable-Watchdog-first) thành script/doc sửa được; (2) hourly-monitor-stale — re-register đúng D:\\scp qua installer hoặc xóa; (3) dashboard-bind — knob cấu hình bind host; (4) hygiene-files — quy trình kiểm tra rồi dọn 2 file (phân biệt junk với dữ liệu thật); (5) image-rebuild + port-doc — gom thành 1 việc đồng bộ doc/evidence với compose thực tế; (6) lockfile-audit — job pip-audit trên Linux CI cho lockfile.",
  ),
  agent("Lập checklist việc của owner", {
    system:
      "Bạn là trợ lý lập kế hoạch. CHỈ ĐỌC. Viết checklist hành động cụ thể, mỗi bước là một việc owner tự làm được, kèm lý do + rủi ro nếu trễ. " + constraints,
  }).ask<ClusterPlan>(
    commonAsk + " Cụm của bạn: " + JSON.stringify(invOwner) + " " +
    "Yêu cầu riêng: (1) own-token — các bước rotate GitHub_TOKEN an toàn (tạo token mới → cập nhật .env → thu hồi cũ → smoke test gh); (2) own-provider-keys — tiêu chí chọn provider/model để crosscheck ĐỘC LẬP THẬT SỰ (khác model hoàn toàn, không cùng nemotron) + số lượng tối thiểu; (3) own-hostenv — kế hoạch nâng theo đợt an toàn (nhóm nào nâng được ngay, nhóm nào chờ, nhóm nào chấp nhận rủi ro có documented); (4) own-electron + own-copyright + own-zonefix — gọn từng mục.",
  ),
]);

phase("Ghép lộ trình wave");

const sequencer = agent("Giám đốc lộ trình", {
  system:
    "Bạn là giám đốc lộ trình remediation SCP. Đọc .agents/skills/scp-dna/SKILL.md và .agents/EXECUTION_PROTOCOL.md trước khi xếp lịch. CHỈ ĐỌC, không sửa file. " +
    "Mỗi wave phải có điều kiện bắt đầu + nghiệm thu đo đếm được + blocker. Viết tiếng Việt.",
});
const draftPlan = await sequencer.ask<MasterPlan>(
  "Ghép 4 cụm thiết kế thành lộ trình wave. Nguyên tắc: W0 = việc owner + quyết định mở khóa (không đụng code); ưu tiên user-impact cao nhất trước; wave đụng cùng một nhóm file phải tách thứ tự; mỗi wave kết thúc bằng full pytest + T00 + verify_scp_test_skill_contract + Mimosa pre-commit + GitHub gates same-SHA trước khi sang wave kế; wave /ask dùng battery 16 probe làm acceptance đo trước/sau.\n\n" +
  "Cụm /ask: " + JSON.stringify(askPlan) + "\n\n" +
  "Cụm nợ code & CI: " + JSON.stringify(debtPlan) + "\n\n" +
  "Cụm vận hành: " + JSON.stringify(opsPlan) + "\n\n" +
  "Cụm owner: " + JSON.stringify(ownerPlan) + "\n\n" +
  "Yêu cầu: (1) waves W0..Wn với goal/items(=issueId theo thứ tự)/entryCriteria/acceptance/blockers; (2) conflictsResolved — liệt kê mọi chỗ file chồng nhau hoặc thứ tự bắt buộc bạn đã xử lý; (3) openDecisions — những gì owner phải quyết (dashboard bind, KILL semantics, contract-5 phương án...) kèm options + recommendation; (4) summary + overview. Không phát minh issue mới — chỉ xếp những cái đã có.",
);

phase("Soát độc lập rồi đăng phương án");

const feedback = await agent("Người đọc thử phương án", {
  system:
    "Bạn đọc phương án như kỹ sư sẽ THỰC THI nó, chỉ dựa vào văn bản được đưa, không kiểm chứng repo, không sửa file. Phản biện là động tác dễ nhất: chỉ ra chỗ sẽ gãy, chỗ thiếu, chỗ acceptance không đo được.",
}).ask<ReviewFeedback>(
  "Đây là phương án xử lý SCP sắp trình owner duyệt:\n\n" + JSON.stringify(draftPlan) +
  "\n\nChỉ ra: (1) problems — bước nào khi thực thi sẽ gãy hoặc mâu thuẫn ràng buộc FA/T00/Mimosa; (2) missing — thiếu việc gì (rollback, thứ tự, dependency); (3) unmeasurable — acceptance nào không đo đếm được hoặc ngưỡng vô nghĩa. Mảng rỗng nếu không có.",
);

let plan = draftPlan;
let revisionNote = "Người đọc thử không có góp ý — giữ nguyên bản nháp.";
if (feedback.problems.length > 0 || feedback.missing.length > 0 || feedback.unmeasurable.length > 0) {
  plan = await sequencer.ask<MasterPlan>(
    "Người đọc thử đã soát bản nháp với phản hồi sau:\n" + JSON.stringify(feedback, null, 2) +
    "\n\nBản nháp:\n" + JSON.stringify(draftPlan) +
    "\n\nChỉnh phương án để xử lý TỪNG điểm phản hồi (giữ nguyên những phần không bị phản đối), trả về MasterPlan hoàn chỉnh. Đồng thời mô tả trong overview bạn đã đổi gì.",
  );
  revisionNote = "Đã chỉnh theo phản hồi người đọc thử: " + (plan.overview.slice(0, 300));
}

const allIssues: IssueSeed[] = [...invAsk, ...invDebt, ...invOps, ...invOwner];

const md = [
  "# Phương án xử lý tổng hợp SCP — post-audit 2026-10-02",
  "",
  "- **HEAD cơ sở:** `" + sha + "` — mọi fix đụng đúng SHA này, mỗi wave kết thúc cần gates xanh same-SHA.",
  "- **Nguồn:** vòng 1 (static, PASS_WITHIN_SCOPE, 2 MEDIUM), vòng 2 (runtime live, PASS_WITHIN_SCOPE), vòng 3 (root-cause /ask, 7 root-causes) + residual GA.md B1a.",
  "- **Soát:** phương án đã qua 1 lượt người đọc thử độc lập. " + revisionNote,
  "",
  "## Tóm tắt lộ trình",
  "",
  plan.summary,
  "",
  plan.overview,
  "",
  "## Các wave",
  "",
  ...plan.waves.flatMap((w) => [
    "### " + w.wave,
    "",
    w.goal,
    "",
    "- **Thứ tự xử lý:** " + w.items.join(" → "),
    "- **Điều kiện bắt đầu:** " + (w.entryCriteria.length > 0 ? w.entryCriteria.join("; ") : "—"),
    "- **Nghiệm thu:** " + (w.acceptance.length > 0 ? w.acceptance.join("; ") : "—"),
    "- **Blocker:** " + (w.blockers.length > 0 ? w.blockers.join("; ") : "không"),
    "",
  ]),
  "## Chi tiết fix từng issue",
  "",
  ...[askPlan, debtPlan, opsPlan, ownerPlan].flatMap((cp, i) => {
    const names = ["/ask pipeline", "nợ code & CI", "vận hành & deployment", "owner checklist"];
    return [
      "### Cụm " + names[i],
      "",
      cp.summary,
      "",
      ...cp.items.flatMap((it) => [
        "- **[" + it.issueId + "]** " + it.fix,
        "  - Files: `" + it.files + "`",
        "  - Tests: " + it.tests,
        "  - Acceptance: " + it.acceptance,
        "  - Risk/rollback: " + it.risk,
        "  - Owner dependency: " + it.ownerDependency + " | Estimate: " + it.estimate,
      ]),
      ...(cp.notes.length > 0 ? cp.notes.map((n) => "- Ghi chú cụm: " + n) : []),
      "",
    ];
  }),
  "## Quyết định owner phải chốt trước khi chạy",
  "",
  ...plan.openDecisions.map((d) => "- **" + d.decision + "** — Options: " + d.options + " — **Khuyến nghị:** " + d.recommendation),
  "",
  "## Xung đột đã xử lý khi xếp lịch",
  "",
  ...plan.conflictsResolved.map((c) => "- " + c),
  "",
  "## Inventory đầy đủ (" + allIssues.length + " issue)",
  "",
  "| id | Mức | Khu vực | Vấn đề |",
  "|---|---|---|---|",
  ...allIssues.map((s) => "| " + s.id + " | " + s.severity + " | " + s.area + " | " + s.title + " |"),
  "",
  "## Ràng buộc thi hành (áp dụng mọi wave)",
  "",
  constraints,
].join("\n");

await artifact.markdown("master-remediation-plan", md, {
  title: "Phương án xử lý tổng hợp SCP (chờ owner duyệt)",
  description: allIssues.length + " issue từ 3 vòng audit → " + plan.waves.length + " wave xử lý, kèm fix chi tiết, nghiệm thu và quyết định cần owner chốt.",
  primary: true,
});

const result: WorkflowReport = {
  conclusion: plan.summary + " " + plan.overview,
  findings: allIssues,
  verified: [
    "HEAD cơ sở " + sha + " (`git rev-parse HEAD`); inventory 25 issue tổng hợp từ 3 vòng audit cùng SHA",
    "4 cụm thiết kế đều yêu cầu verify lại file:dòng tại HEAD trước khi đề xuất fix; kế thừa bằng chứng TEMP của vòng 3 (probe results + server log + battery script)",
    "Phương án đã qua 1 lượt người đọc thử độc lập" + (revisionNote.startsWith("Đã chỉnh") ? " và 1 lượt chỉnh sửa" : " (không có góp ý)"),
  ],
  notCovered: [
    "Đây là PHƯƠNG ÁN — chưa fix code, chưa chạy wave nào; mọi acceptance là kế hoạch chờ thực thi",
    "Người đọc thử soát theo văn bản, không kiểm chứng lại repo",
    "Các issue phụ thuộc owner (provider keys, token rotate) chưa thể nghiệm thu đến nơi cho đến khi owner hành động",
  ],
};
return result;