  { id: "own-provider-keys", title: "Provider rotation chỉ còn groq+groq3 (cùng model nemotron)", severity: "medium", area: "owner/llm", where: ".env rotation + SCP_LLM_EGRESS_ALLOWLIST", status: "vòng 2: 3/5 fallback chết (sambanova 401, cerebras 402, gemini 404); BLOCKER cho nghiệm thu root-3 (cần family THẬT SỰ độc lập — khác model, không chỉ khác provider name)" },
  { id: "own-electron", title: "Electron GUI build (cần máy có display)", severity: "low", area: "owner/build", where: "desktop/", status: "GA B1a item 3 residual" },
