name: SCP Refactor Freeze

on:
  push:
    branches:
      - refactor/system-refactor-hardening-20260901

permissions:
  contents: write

concurrency:
  group: scp-refactor-freeze-${{ github.ref }}
  cancel-in-progress: true

env:
  SCP_JWT_SECRET: "dummy_secret_for_ci"
  SCP_ADMIN_KEY: "refactor-freeze-admin-key-0123456789"
  SCP_PRODUCTION_MODE: '0'
  SCP_SKIP_STARTUP_GATE: '0'
  SCP_EGRESS_MODE: deny
  SCP_PORT: '8000'
  PORT: '8000'
  PYTHONUTF8: '1'

jobs:
  freeze:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ github.sha }}
          fetch-depth: 2

      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.12'

      - name: Prove exact SHA checkout
        run: test "$(git rev-parse HEAD)" = "${{ github.sha }}"

      - name: Verify Python 3.12 runtime
        shell: bash
        run: python -c "import sys; assert sys.version_info[:2] == (3, 12), sys.version; print(sys.version)"

      - name: Verify Node 20 runtime
        shell: bash
        run: node -e "if (process.versions.node.split('.')[0] !== '20') { throw new Error(process.version) } console.log(process.version)"

      - name: Install dependencies
        run: |
          python -m pip install -r scp/requirements-dev.txt
          python -m pip check

      - name: SCP DNA and required-skill contract
        run: |
          python tools/verify_scp_test_skill_contract.py --output reports/test_skill_contract.json
          python -m pytest -q tests/test_scp_skill_dna_contract.py tests/test_scp_test_skill_contract.py --tb=short

      - name: Compile committed source
        run: python -m compileall -q scp scripts tools tests

      - name: Ruff committed-source syntax and undefined names
        run: python -m ruff check scp scripts tools tests --select E9,F

      - name: Required imports must be source-tree pure
        run: python tools/check_import_source_purity.py

      - name: Semantic parity and provider contracts
        run: >-
          python -m pytest -q
          tests/test_god_split_semantic_parity.py
          tests/test_provider_failover.py
          tests/test_provider_timeout_recovery.py
          tests/test_llm_egress_policy.py
          tests/test_multi_llm_crosscheck.py
          tests/test_multi_llm_crosscheck_concurrency.py
          tests/external_audit/test_cascade.py
          tests/test_release_authority_contract.py
          --tb=short

      - name: Full unit and integration suite
        run: python -m pytest -q --tb=short

      - name: SCP behavioral acceptance
        run: python scripts/run_scp_acceptance_ci.py --output-dir reports/scp_acceptance_refactor

      - name: Fail-closed verification infrastructure
        run: python -m pytest -q tests/test_test_infrastructure_fail_closed.py --tb=short

      - name: Mutation sensitivity gate
        run: python scripts/run_mutation_ci.py --max-mutants 5 --min-score 0.40 --report reports/mutation/mutation_report.json

      - name: Bandit production policy
        shell: bash
        run: |
          set +e
          python -m bandit -r scp -x scp/examples,scp/tools,scp/venv -f json -o bandit-prod.json
          bandit_exit=$?
          set -e
          python tools/summarize_bandit_report.py bandit-prod.json --output bandit-prod-summary.json
          python tools/check_bandit_policy.py bandit-prod-summary.json --max-medium 9
          if [ "$bandit_exit" -gt 1 ]; then exit "$bandit_exit"; fi

      - name: Portable reality suite
        run: python scripts/run_reality_tests_portable.py

      - name: TaskKernel durability and recovery soak
        run: >-
          python scripts/scp_soak_test.py
          --duration-seconds 12
          --run-id refactor-freeze
          --output-dir reports/soak/refactor-freeze
          --workers 4
          --batch-size 2
          --interval-seconds 0.2
          --integrity-interval-seconds 2
          --report-interval-seconds 2
          --min-free-mb 0

      - name: Strict full-system audit
        run: python -m scripts.run_system_audit_strict

      - name: Bounded full-system runtime smoke
        run: python tools/run_bounded_system_smoke.py --output-dir reports/bounded_system_smoke_refactor

      - name: Dashboard install, production audit, and build
        working-directory: dashboard
        run: |
          npm ci --ignore-scripts
          npm audit --omit=dev --audit-level=high
          npm run build

      - name: Verify or freeze exact product-tree manifest
        id: manifest
        shell: bash
        run: |
          set -euo pipefail
          MANIFEST=reports/manifests_202608/ROOT_SCP_SNAPSHOT_MANIFEST_20260826.json
          if python tools/verify_snapshot_manifest.py "$MANIFEST" | tee reports/refactor-manifest-verification.json; then
            echo "ready=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          BRANCH_SHA="$(git ls-remote origin refs/heads/refactor/system-refactor-hardening-20260901 | cut -f1)"
          test "$BRANCH_SHA" = "$GITHUB_SHA"
          python tools/create_snapshot_manifest.py --commit "$GITHUB_SHA" --output "$MANIFEST"
          git add "$MANIFEST"
          CHANGED="$(git diff --cached --name-only)"
          test "$CHANGED" = "$MANIFEST"
          git config user.name "scp-refactor-freeze-bot"
          git config user.email "scp-refactor-freeze-bot@users.noreply.github.com"
          git commit -m "chore(refactor): freeze manifest for $GITHUB_SHA"
          git push origin HEAD:refs/heads/refactor/system-refactor-hardening-20260901
          echo "ready=false" >> "$GITHUB_OUTPUT"

      - name: Write exact-SHA refactor verdict
        if: ${{ steps.manifest.outputs.ready == 'true' }}
        run: |
          mkdir -p reports/release
          python - <<'PY'
          import json, os
          from pathlib import Path
          manifest = json.loads(Path('reports/manifests_202608/ROOT_SCP_SNAPSHOT_MANIFEST_20260826.json').read_text(encoding='utf-8'))
          payload = {
              'sha': os.environ['GITHUB_SHA'],
              'manifest_captured_commit': manifest['captured_commit'],
              'manifest_tree': manifest['captured_tree'],
              'skill_dna_contract': 'PASS',
              'required_gates': {
                  'compile_import': 'PASS',
                  'unit_integration': 'PASS',
                  'semantic_parity': 'PASS',
                  'skill_scp_dna_contract': 'PASS',
                  'acceptance': 'PASS',
                  'fail_closed': 'PASS',
                  'bandit_security': 'PASS',
                  'mutation': 'PASS',
                  'provider_failover_timeout': 'PASS',
                  'taskkernel_durability_recovery': 'PASS',
                  'reality_tests': 'PASS',
                  'bounded_runtime_smoke': 'PASS',
                  'dashboard_build_audit': 'PASS',
                  'manifest_provenance': 'PASS',
              },
              'blockers': 0,
              'verdict': 'REFACTOR_FREEZE_READY',
          }
          Path('reports/release/refactor-freeze-verdict.json').write_text(
              json.dumps(payload, indent=2, sort_keys=True) + '\n', encoding='utf-8'
          )
          PY

      - name: Upload refactor evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: scp-refactor-freeze-${{ github.sha }}
          path: |
            reports/test_skill_contract.json
            reports/scp_acceptance_refactor/
            reports/mutation/mutation_report.json
            bandit-prod.json
            bandit-prod-summary.json
            reports/soak/refactor-freeze/
            reports/system_audit_strict/
            reports/bounded_system_smoke_refactor/
            reports/refactor-manifest-verification.json
            reports/release/refactor-freeze-verdict.json
          if-no-files-found: warn
          retention-days: 30
