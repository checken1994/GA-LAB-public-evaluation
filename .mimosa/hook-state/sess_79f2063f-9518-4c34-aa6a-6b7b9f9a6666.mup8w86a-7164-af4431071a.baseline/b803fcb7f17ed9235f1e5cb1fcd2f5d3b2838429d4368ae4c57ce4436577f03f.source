name: SCP CI Baseline (Non-Authoritative)

on: [push, pull_request]

permissions:
  contents: read

env:
  SCP_JWT_SECRET: "baseline-ci-jwt-secret-0123456789abcdef0123456789"
  SCP_ADMIN_KEY: "baseline-ci-admin-key-0123456789"
  SCP_PRODUCTION_MODE: '0'
  SCP_SKIP_STARTUP_GATE: '0'
  SCP_EGRESS_MODE: deny
  PYTHONUTF8: '1'

jobs:
  p0-baseline:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: "3.12"
      - name: Install dependencies
        run: |
          python -m pip install -r scp/requirements-dev.txt
          python -m pip check
      # The baseline suite includes bun -e dashboard-contract tests and the
      # live cluster e2e (next dev on :3000); without bun + dashboard
      # node_modules those four tests fail with FileNotFoundError 'bun' /
      # unresolved next/server on a clean runner.
      - name: Set up Bun
        uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2
        with:
          bun-version: "1.3.14"
      - name: Install dashboard dependencies for baseline suite
        working-directory: dashboard
        run: npm ci --ignore-scripts --no-audit
      - name: Enforce Baseline (P0)
        run: python scripts/enforce_baseline.py

      # This workflow is a fast baseline only. It must never emit release or
      # customer-handoff verdicts; scp-rc-promotion.yml is the sole authority.
