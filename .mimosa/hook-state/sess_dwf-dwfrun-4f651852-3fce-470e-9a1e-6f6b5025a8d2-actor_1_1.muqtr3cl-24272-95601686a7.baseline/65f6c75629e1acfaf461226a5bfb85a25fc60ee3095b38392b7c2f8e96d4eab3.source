{
  "name": "scp-loop-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Closed-loop scheduler mini-service for SCP. Periodically calls SCP's /v105/autofix/run-audit endpoint, logs results, exposes a dashboard on port 3030.",
  "scripts": {
    "dev": "bun --hot index.ts",
    "start": "bun index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
