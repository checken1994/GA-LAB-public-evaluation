export const SCANNERS_BY_TYPE = SCP_SCANNERS.reduce(
  (acc, s) => {
    if (!acc[s.type]) acc[s.type] = []
    acc[s.type].push(s)
    return acc
  },
  {} as Record<string, ScannerInfo[]>,
)

export const IMPROVED_SCANNERS = SCP_SCANNERS.filter((s) => s.r7Improved)
