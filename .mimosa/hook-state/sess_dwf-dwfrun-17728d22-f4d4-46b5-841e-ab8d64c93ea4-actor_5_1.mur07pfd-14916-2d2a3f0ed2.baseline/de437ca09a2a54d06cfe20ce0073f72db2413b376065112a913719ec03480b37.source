/**
 * SCP Scanner Registry (separate file per task)
 *
 * 18 SCP scanners + 6 external tools. Mỗi scanner có blind-spot
 * được map (DNA #19: khả năng quan sát chưa đủ).
 *
 * R7 cải thiện 4 scanner (R7-11): null_safety, dead_code, resource_leak, sql_injection.
 */

export interface ScannerInfo {
  id: string
  name: string
  type: "scp-own" | "external"
  category: string
  loc: number
  catchesWhat: string
  blindSpot: string
  r7Findings: number
  r6Findings: number
  r7Improved: boolean
  improvement?: string
  file?: string
}

